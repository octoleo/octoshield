#!/usr/bin/env bats
# SPDX-License-Identifier: Apache-2.0
# Captured-style iptables-save fixtures; no host firewall commands are executed.
# shellcheck disable=SC2317,SC2329,SC2016

setup() {
    bats_require_minimum_version 1.5.0
    source "$BATS_TEST_DIRNAME/../src/lib/profiles.sh"
    source "$BATS_TEST_DIRNAME/../src/lib/profile_firewall_verify.sh"
    TEST_IPV4_RULES=''
    TEST_IPV6_RULES=''
    TEST_INPUT_POLICY=DROP
    TEST_EXTRA_INPUT=''
    TEST_FAIL_IPV6=no
    TEST_MUTATIONS="$BATS_TEST_TMPDIR/mutations"
    : >"$TEST_MUTATIONS"
    iptables-save() { fixture_native 4 "$TEST_IPV4_RULES"; }
    ip6tables-save() {
        [[ $TEST_FAIL_IPV6 != yes ]] || return 1
        fixture_native 6 "$TEST_IPV6_RULES"
    }
    iptables() { printf 'iptables %s\n' "$*" >>"$TEST_MUTATIONS"; }
    ip6tables() {
        printf 'ip6tables %s\n' "$*" >>"$TEST_MUTATIONS"
        [[ $TEST_FAIL_IPV6 != yes ]]
    }
    ufw() { printf 'ufw %s\n' "$*" >>"$TEST_MUTATIONS"; }
}

fixture_native() {
    local prefix=ufw
    [[ $1 == 4 ]] || prefix=ufw6
    printf '# Generated by iptables-save\n*filter\n'
    printf ':INPUT %s [107:9825]\n:FORWARD DROP [0:0]\n:OUTPUT ACCEPT [502:90313]\n' "$TEST_INPUT_POLICY"
    printf ':%s-user-input - [0:0]\n:%s-user-output - [0:0]\n:%s-user-forward - [0:0]\n' "$prefix" "$prefix" "$prefix"
    printf '%s\n' "-A INPUT -j $prefix-before-logging-input" "-A INPUT -j $prefix-before-input" "-A INPUT -j $prefix-after-input"
    printf '%s\n' "-A $prefix-before-input -i lo -j ACCEPT" "-A $prefix-before-input -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT"
    if [[ $1 == 4 ]]; then
        printf '%s\n' '-A ufw-before-input -p udp -m udp --sport 67 --dport 68 -j ACCEPT' '-A ufw-before-input -p icmp -m icmp --icmp-type 8 -j ACCEPT'
    else
        printf '%s\n' '-A ufw6-before-input -s fe80::/10 -d fe80::/10 -p udp -m udp --sport 547 --dport 546 -j ACCEPT' \
            '-A ufw6-before-input -p ipv6-icmp -m icmp6 --icmpv6-type 135 -m hl --hl-eq 255 -j ACCEPT'
    fi
    printf '%s\n' "-A $prefix-before-input -j $prefix-user-input"
    [[ -z $TEST_EXTRA_INPUT ]] || printf '%s\n' "$TEST_EXTRA_INPUT"
    [[ -z $2 ]] || printf '%s\n' "$2"
    printf 'COMMIT\n# Completed\n'
}

fixture_config() {
    jq -cn --arg source "${1:-any}" --arg interface "${2:-any}" --arg protocol "${3:-tcp}" --argjson port "${4:-443}" --argjson expires "${5:-0}" \
        '{rules:[{id:"r1-1-1",port:$port,protocol:$protocol,source:$source,interface:$interface,expires_at:$expires}]}'
}

@test 'closed UFW user chains verify only when both IP families exist' {
    run profile_firewall::verify '{"rules":[]}'
    [ "$status" -eq 0 ]
    TEST_FAIL_IPV6=yes
    run profile_firewall::verify '{"rules":[]}'
    [ "$status" -ne 0 ]
}

@test 'any-source allowance requires the precise port and protocol in both families' {
    TEST_IPV4_RULES='-A ufw-user-input -p tcp -m tcp --dport 443 -j ACCEPT'
    TEST_IPV6_RULES='-A ufw6-user-input -p tcp -m tcp --dport 443 -j ACCEPT'
    run profile_firewall::verify "$(fixture_config)"
    [ "$status" -eq 0 ]
    TEST_IPV6_RULES=''
    run profile_firewall::verify "$(fixture_config)"
    [ "$status" -ne 0 ]
    TEST_IPV6_RULES='-A ufw6-user-input -p udp -m udp --dport 443 -j ACCEPT'
    run profile_firewall::verify "$(fixture_config)"
    [ "$status" -ne 0 ]
}

@test 'source and interface scopes must match instead of merely counting rules' {
    TEST_IPV4_RULES='-A ufw-user-input -s 192.168.4.0/24 -i wlan0 -p tcp -m tcp --dport 443 -j ACCEPT'
    run profile_firewall::verify "$(fixture_config 192.168.4.99/24 wlan0)"
    [ "$status" -eq 0 ]
    run profile_firewall::verify "$(fixture_config 192.168.5.0/24 wlan0)"
    [ "$status" -ne 0 ]
    run profile_firewall::verify "$(fixture_config 192.168.4.0/24 eth0)"
    [ "$status" -ne 0 ]
    TEST_IPV4_RULES='-A ufw-user-input -p tcp -m tcp --dport 443 -j ACCEPT'
    run profile_firewall::verify "$(fixture_config 192.168.4.0/24 wlan0)"
    [ "$status" -ne 0 ]
}

@test 'IPv6 compressed and expanded addresses normalize without losing prefix boundaries' {
    TEST_IPV6_RULES='-A ufw6-user-input -s 2001:db8:abcd:1200::/57 -p udp -m udp --dport 88 -j ACCEPT'
    run profile_firewall::verify "$(fixture_config 2001:0DB8:ABCD:1234:0000:0000:0000:0001/57 any udp 88)"
    [ "$status" -eq 0 ]
    run profile_firewall::verify "$(fixture_config 2001:db8:abcd:1280::/57 any udp 88)"
    [ "$status" -ne 0 ]
    TEST_IPV6_RULES='-A ufw6-user-input -s ::1/128 -p tcp -m tcp --dport 443 -j ACCEPT'
    run profile_firewall::verify "$(fixture_config 0:0:0:0:0:0:0:1)"
    [ "$status" -eq 0 ]
    TEST_IPV6_RULES='-A ufw6-user-input -s ::ffff:192.168.4.0/120 -p tcp -m tcp --dport 443 -j ACCEPT'
    run profile_firewall::verify "$(fixture_config ::ffff:c0a8:400/120)"
    [ "$status" -eq 0 ]
}

@test 'canonical network normalization handles zero and full-width masks' {
    run profile_firewall::_network 4 255.255.255.255/0
    [ "$status" -eq 0 ]
    [ "$output" = '4:00000000/0' ]
    run profile_firewall::_network 4 255.255.255.255/32
    [ "$status" -eq 0 ]
    [ "$output" = '4:ffffffff/32' ]
    run profile_firewall::_network 6 ffff:ffff:ffff:ffff:ffff:ffff:ffff:ffff/0
    [ "$status" -eq 0 ]
    [ "$output" = '6:00000000000000000000000000000000/0' ]
    run profile_firewall::_network 6 ffff:ffff:ffff:ffff:ffff:ffff:ffff:ffff/128
    [ "$status" -eq 0 ]
    [ "$output" = '6:ffffffffffffffffffffffffffffffff/128' ]
}

@test 'unexpected grants and altered defaults fail verification' {
    TEST_IPV4_RULES='-A ufw-user-input -p tcp -m tcp --dport 22 -j ACCEPT'
    run profile_firewall::verify '{"rules":[]}'
    [ "$status" -ne 0 ]
    TEST_IPV4_RULES=''
    TEST_INPUT_POLICY=ACCEPT
    run profile_firewall::verify '{"rules":[]}'
    [ "$status" -ne 0 ]
    TEST_INPUT_POLICY=DROP
    TEST_EXTRA_INPUT='-A INPUT -p tcp --dport 22 -j ACCEPT'
    run profile_firewall::verify '{"rules":[]}'
    [ "$status" -ne 0 ]
    TEST_EXTRA_INPUT='-A INPUT -j OTHER-ADMIN-CHAIN'
    run profile_firewall::verify '{"rules":[]}'
    [ "$status" -ne 0 ]
}

@test 'unexpected native matcher syntax never becomes an accepted approximation' {
    local rule
    for rule in \
        '-A ufw-user-input -p tcp -m multiport --dports 22,443 -j ACCEPT' \
        '-A ufw-user-input ! -s 10.0.0.0/8 -p tcp --dport 443 -j ACCEPT' \
        '-A ufw-user-input -p tcp --dport 443 -j OTHER' \
        '-A ufw-user-input -p tcp -p udp --dport 443 -j ACCEPT' \
        '-A ufw-user-input -p tcp --dport 443 -j ACCEPT --comment $(touch_/tmp/no)' \
        '-A ufw-user-input -p tcp --dport 443 -j ACCEPT -s' \
        '-A ufw-user-input -i eth+ -p tcp --dport 443 -j ACCEPT'; do
        TEST_IPV4_RULES=$rule
        run profile_firewall::verify "$(fixture_config 0.0.0.0/0)"
        [ "$status" -ne 0 ]
    done
}

@test 'unexpected outgoing or forwarding user rules are not silently retained' {
    TEST_IPV4_RULES='-A ufw-user-forward -p tcp -m tcp --dport 443 -j ACCEPT'
    run profile_firewall::verify '{"rules":[]}'
    [ "$status" -ne 0 ]
    TEST_IPV4_RULES='-A ufw-user-output -p tcp -m tcp --dport 22 -j DROP'
    run profile_firewall::verify '{"rules":[]}'
    [ "$status" -ne 0 ]
}

@test 'vendor multicast discovery grants cannot bypass explicit profile exceptions' {
    TEST_IPV4_RULES='-A ufw-before-input -d 224.0.0.251/32 -p udp -m udp --dport 5353 -j ACCEPT'
    run profile_firewall::verify '{"rules":[]}'
    [ "$status" -ne 0 ]
    TEST_IPV4_RULES='-A ufw-before-input -d 239.255.255.250/32 -p udp -m udp --dport 1900 -j ACCEPT'
    run profile_firewall::verify '{"rules":[]}'
    [ "$status" -ne 0 ]
    TEST_IPV4_RULES=''
    TEST_IPV6_RULES='-A ufw6-before-input -d ff02::fb/128 -p udp -m udp --dport 5353 -j ACCEPT'
    run profile_firewall::verify '{"rules":[]}'
    [ "$status" -ne 0 ]
    TEST_IPV6_RULES='-A ufw6-before-input -d ff02::f/128 -p udp -m udp --dport 1900 -j ACCEPT'
    run profile_firewall::verify '{"rules":[]}'
    [ "$status" -ne 0 ]
}

@test 'a broad or altered DHCP exemption and unconditional native input accept fail closed' {
    local rule
    for rule in \
        '-A ufw-before-input -p udp -m udp --dport 68 -j ACCEPT' \
        '-A ufw-before-input -p udp -m udp --sport 67 --dport 443 -j ACCEPT' \
        '-A ufw-before-input -j ACCEPT' \
        '-A ufw-track-input -p tcp -m conntrack --ctstate NEW -j ACCEPT' \
        '-A ufw-after-input -p tcp -m tcp --dport 443 -j ACCEPT'; do
        TEST_IPV4_RULES=$rule
        run profile_firewall::verify '{"rules":[]}'
        [ "$status" -ne 0 ]
    done
    TEST_IPV4_RULES=''
    TEST_IPV6_RULES='-A ufw6-before-input -p udp -m udp --sport 547 --dport 546 -j ACCEPT'
    run profile_firewall::verify '{"rules":[]}'
    [ "$status" -ne 0 ]
}

@test 'an expired configured exception never permits an unbounded running grant' {
    run profile_firewall::verify "$(fixture_config any any tcp 443 1)"
    [ "$status" -eq 0 ]
    TEST_IPV4_RULES='-A ufw-user-input -p tcp -m tcp --dport 443 -j ACCEPT'
    TEST_IPV6_RULES='-A ufw6-user-input -p tcp -m tcp --dport 443 -j ACCEPT'
    run profile_firewall::verify "$(fixture_config any any tcp 443 1)"
    [ "$status" -ne 0 ]
}

@test 'duplicate configured scopes match UFW deduplication without permitting extra access' {
    local config
    config=$(fixture_config | jq -c '.rules += .rules | .rules[1].id="r1-1-2"')
    TEST_IPV4_RULES='-A ufw-user-input -p tcp -m tcp --dport 443 -j ACCEPT'
    TEST_IPV6_RULES='-A ufw6-user-input -p tcp -m tcp --dport 443 -j ACCEPT'
    run profile_firewall::verify "$config"
    [ "$status" -eq 0 ]
}

@test 'malformed desired scope is rejected before inspecting native tables' {
    iptables-save() {
        printf 'unexpected native invocation\n' >"$BATS_TEST_TMPDIR/called"
        return 1
    }
    run profile_firewall::verify '{"rules":[{"port":443,"protocol":"tcp","source":"$(id)","interface":"any","expires_at":0}]}'
    [ "$status" -ne 0 ]
    [ ! -e "$BATS_TEST_TMPDIR/called" ]
    run profile_firewall::verify '{"rules":[{"port":443,"protocol":"tcp","source":"any","interface":"any","expires_at":"0;id"}]}'
    [ "$status" -ne 0 ]
    [ ! -e "$BATS_TEST_TMPDIR/called" ]
}

@test 'finite grants are added only to runtime chains in the appropriate address families' {
    local expires stop
    expires=$(($(date +%s) + 3600))
    stop=$(date -u --date="@$((expires - 1))" +%Y-%m-%dT%H:%M:%S)
    run profile_firewall::temporary_apply "$(fixture_config any wlan0 tcp 443 "$expires")"
    [ "$status" -eq 0 ]
    [ "$(sed -n '1p' "$TEST_MUTATIONS")" = "iptables -w 5 -A ufw-user-input -i wlan0 -p tcp --dport 443 -m time --datestop $stop -j ACCEPT" ]
    [ "$(sed -n '2p' "$TEST_MUTATIONS")" = "ip6tables -w 5 -A ufw6-user-input -i wlan0 -p tcp --dport 443 -m time --datestop $stop -j ACCEPT" ]
    : >"$TEST_MUTATIONS"
    run profile_firewall::temporary_apply "$(fixture_config 2001:db8::/64 any udp 88 "$expires")"
    [ "$status" -eq 0 ]
    [ "$(cat "$TEST_MUTATIONS")" = "ip6tables -w 5 -A ufw6-user-input -s 2001:db8::/64 -p udp --dport 88 -m time --datestop $stop -j ACCEPT" ]
}

@test 'permanent and already expired scopes never become temporary native grants' {
    run profile_firewall::temporary_apply "$(fixture_config)"
    [ "$status" -eq 0 ]
    run profile_firewall::temporary_apply "$(fixture_config any any tcp 443 1)"
    [ "$status" -eq 0 ]
    [ ! -s "$TEST_MUTATIONS" ]
}

@test 'partial address-family failure narrows back to the saved permanent UFW policy' {
    local expires
    expires=$(($(date +%s) + 3600))
    TEST_FAIL_IPV6=yes
    run profile_firewall::temporary_apply "$(fixture_config any any tcp 443 "$expires")"
    [ "$status" -ne 0 ]
    [ "$(tail -n 1 "$TEST_MUTATIONS")" = 'ufw reload' ]
    [ "$(wc -l <"$TEST_MUTATIONS")" -eq 3 ]
}

@test 'all temporary scopes are validated before the first native change' {
    local config expires
    expires=$(($(date +%s) + 3600))
    config=$(fixture_config any any tcp 443 "$expires" | jq -c '.rules += .rules | .rules[1].source="--jump ACCEPT"')
    run profile_firewall::temporary_apply "$config"
    [ "$status" -ne 0 ]
    [ ! -s "$TEST_MUTATIONS" ]
}

@test 'finite profile scope requires the exact exclusive UTC kernel deadline' {
    local expires stop
    expires=$(($(date +%s) + 3600))
    stop=$(date -u --date="@$((expires - 1))" +%Y-%m-%dT%H:%M:%S)
    TEST_IPV4_RULES="-A ufw-user-input -p tcp -m tcp --dport 443 -m time --datestop $stop -j ACCEPT"
    TEST_IPV6_RULES="-A ufw6-user-input -p tcp -m tcp --dport 443 -m time --datestop $stop -j ACCEPT"
    run profile_firewall::verify "$(fixture_config any any tcp 443 "$expires")"
    [ "$status" -eq 0 ]
    run profile_firewall::verify "$(fixture_config any any tcp 443 "$((expires + 1))")"
    [ "$status" -ne 0 ]
    TEST_IPV6_RULES='-A ufw6-user-input -p tcp -m tcp --dport 443 -j ACCEPT'
    run profile_firewall::verify "$(fixture_config any any tcp 443 "$expires")"
    [ "$status" -ne 0 ]
}

@test 'kernel-expired grants remain closed when the collector or app is absent' {
    TEST_IPV4_RULES='-A ufw-user-input -p tcp -m tcp --dport 443 -m time --datestop 2000-01-01T00:00:00 -j ACCEPT'
    TEST_IPV6_RULES='-A ufw6-user-input -p tcp -m tcp --dport 443 -m time --datestop 2000-01-01T00:00:00 -j ACCEPT'
    run profile_firewall::verify '{"rules":[]}'
    [ "$status" -eq 0 ]
    # Removing just the time constraint would reopen the port and must fail.
    TEST_IPV4_RULES='-A ufw-user-input -p tcp -m tcp --dport 443 -j ACCEPT'
    run profile_firewall::verify '{"rules":[]}'
    [ "$status" -ne 0 ]
}

@test 'ambiguous kernel timezone and incomplete time matchers are rejected' {
    local rule
    for rule in \
        '-A ufw-user-input -p tcp --dport 443 -m time --datestop 2030-01-01T00:00:00 --kerneltz -j ACCEPT' \
        '-A ufw-user-input -p tcp --dport 443 -m time -j ACCEPT' \
        '-A ufw-user-input -p tcp --dport 443 --datestop 2030-01-01T00:00:00 -j ACCEPT' \
        '-A ufw-user-input -p tcp --dport 443 -m time --datestop 2030-13-01T00:00:00 -j ACCEPT'; do
        TEST_IPV4_RULES=$rule
        run profile_firewall::verify '{"rules":[]}'
        [ "$status" -ne 0 ]
    done
}

@test 'deadlines outside the supported kernel time range fail before grants' {
    run profile_firewall::temporary_apply "$(fixture_config any any tcp 443 2147483648)"
    [ "$status" -ne 0 ]
    [ ! -s "$TEST_MUTATIONS" ]
}

@test 'both families need a unique reachable INPUT and before-to-user hook' {
    local family output
    for family in 4 6; do
        output=$(fixture_native "$family" '')
        run profile_firewall::_native "$family" "$(sed '/^-A INPUT -j ufw6\?-before-input$/d' <<<"$output")"
        [ "$status" -ne 0 ]
        [[ $output == *'INPUT-to-UFW-to-user-rule path'* ]]
        output=$(fixture_native "$family" '')
        run profile_firewall::_native "$family" "$(sed '/^-A .*before-input -j .*user-input$/d' <<<"$output")"
        [ "$status" -ne 0 ]
    done
    output=$(fixture_native 4 '')
    run profile_firewall::_native 4 "${output/COMMIT/$'-A INPUT -j ufw-before-input\nCOMMIT'}"
    [ "$status" -ne 0 ]
}

@test 'unknown nested input jumps and logging accept paths are refused' {
    local rule
    for rule in \
        $'-A ufw-before-input -j CUSTOM\n-A CUSTOM -j ACCEPT' \
        $'-A ufw-not-local -j CUSTOM\n-A CUSTOM -j ACCEPT' \
        '-A ufw-logging-deny -j ACCEPT' \
        '-A ufw-before-input -g ufw-user-input'; do
        TEST_EXTRA_INPUT=$rule
        run profile_firewall::verify '{"rules":[]}'
        [ "$status" -ne 0 ]
        [[ $output == *'unrecognized UFW input-chain jump'* ]]
    done
}

@test 'vendor logging and not-local paths remain supported without claiming Docker forwarding coverage' {
    TEST_EXTRA_INPUT=$'-A ufw-before-input -m conntrack --ctstate INVALID -j ufw-logging-deny\n-A ufw-before-input -m conntrack --ctstate INVALID -j DROP\n-A ufw-before-input -j ufw-not-local\n-A ufw-not-local -m addrtype --dst-type LOCAL -j RETURN\n-A ufw-not-local -j DROP\n-A ufw-after-input -m addrtype --dst-type BROADCAST -j ufw-skip-to-policy-input\n-A ufw-skip-to-policy-input -j DROP\n-A ufw-logging-deny -m limit --limit 3/min -j LOG --log-prefix "[UFW BLOCK] "\n-A FORWARD -j DOCKER-USER\n-A DOCKER-USER -j ACCEPT'
    # The IPv4-only extension is irrelevant to the IPv6 fixture, just as
    # unrelated non-UFW forwarding chains are outside host-input verification.
    run profile_firewall::verify '{"rules":[]}'
    [ "$status" -eq 0 ]
    [ ! -s "$TEST_MUTATIONS" ]
}

@test 'configured forwarding DROP is required even when UFW calls routing disabled' {
    local defaults="$BATS_TEST_TMPDIR/ufw-defaults"
    printf 'IPV6=yes\nDEFAULT_INPUT_POLICY="DROP"\nDEFAULT_OUTPUT_POLICY="ACCEPT"\nDEFAULT_FORWARD_POLICY="DROP"\n' >"$defaults"
    profile_firewall::defaults "$defaults"
    sed -i 's/DEFAULT_FORWARD_POLICY="DROP"/DEFAULT_FORWARD_POLICY="ACCEPT"/' "$defaults"
    run profile_firewall::defaults "$defaults"
    [ "$status" -ne 0 ]
    [[ $output == *'DROP for incoming and forwarded'* ]]
    printf 'DEFAULT_FORWARD_POLICY="DROP"\n' >>"$defaults"
    run profile_firewall::defaults "$defaults"
    [ "$status" -ne 0 ]
}

@test 'reviewed reconciliation accepts vendor discovery but refuses an injected broad before-input grant' {
    local native
    TEST_EXTRA_INPUT='-A ufw-before-input -d 224.0.0.251/32 -p udp -m udp --dport 5353 -j ACCEPT'
    native=$(fixture_native 4 '')
    run profile_firewall::_native 4 "$native" 0 reconcile
    [ "$status" -eq 0 ]
    TEST_EXTRA_INPUT='-A ufw-before-input -p tcp -m tcp --dport 443 -j ACCEPT'
    run profile_firewall::_native 4 "$(fixture_native 4 '')" 0 reconcile
    [ "$status" -ne 0 ]
}

@test 'each family must retain DROP forwarding and ACCEPT outgoing kernel defaults' {
    local family native
    for family in 4 6; do
        native=$(fixture_native "$family" '')
        run profile_firewall::_native "$family" "${native/:FORWARD DROP/:FORWARD ACCEPT}"
        [ "$status" -ne 0 ]
        [[ $output == *'kernel defaults'* ]]
        run profile_firewall::_native "$family" "${native/:OUTPUT ACCEPT/:OUTPUT DROP}"
        [ "$status" -ne 0 ]
        [[ $output == *'kernel defaults'* ]]
    done
}

@test 'defaults distinguish literal quoted values from trailing comments without sourcing data' {
    local defaults="$BATS_TEST_TMPDIR/ufw-defaults"
    printf 'IPV6=yes\nDEFAULT_INPUT_POLICY="DROP" # incoming=closed\nDEFAULT_OUTPUT_POLICY="ACCEPT"\nDEFAULT_FORWARD_POLICY="DROP"\n' >"$defaults"
    profile_firewall::defaults "$defaults"
    sed -i 's/DEFAULT_FORWARD_POLICY="DROP"/DEFAULT_FORWARD_POLICY="DROP#not-the-policy"/' "$defaults"
    run profile_firewall::defaults "$defaults"
    [ "$status" -ne 0 ]
}

@test 'inactive UFW primary remnants normalize only when every retained chain is empty' {
    local family prefix stage direction native normalized bad
    for family in 4 6; do
        prefix=ufw
        [[ $family == 4 ]] || prefix=ufw6
        native=$'*filter\n:INPUT ACCEPT [0:0]\n:FORWARD ACCEPT [0:0]\n:OUTPUT ACCEPT [0:0]'
        for stage in before-logging before after after-logging reject track; do
            for direction in input output forward; do
                native+=$'\n'":$prefix-$stage-$direction - [0:0]"
                native+=$'\n'"-A ${direction^^} -j $prefix-$stage-$direction"
            done
        done
        native+=$'\n-A FORWARD -j DOCKER-USER\nCOMMIT'
        normalized=$(profile_firewall::_inactive "$family" "$native")
        [ "$normalized" = $':INPUT ACCEPT\n:FORWARD ACCEPT\n:OUTPUT ACCEPT' ]
        for bad in "-A $prefix-before-input -j ACCEPT" "-A $prefix-after-input -j RETURN" \
            '-A INPUT -j CUSTOM' ":$prefix-custom-input - [0:0]"; do
            run profile_firewall::_inactive "$family" "${native/COMMIT/$bad$'\nCOMMIT'}"
            [ "$status" -ne 0 ]
        done
        run profile_firewall::_inactive "$family" "${native/:INPUT ACCEPT/:INPUT DROP}"
        [ "$status" -eq 0 ]
        [ "$output" = $':INPUT DROP\n:FORWARD ACCEPT\n:OUTPUT ACCEPT' ]
        run profile_firewall::_inactive "$family" "${native/:FORWARD ACCEPT/:FORWARD DROP}"
        [ "$status" -eq 0 ]
        [ "$output" = $':INPUT ACCEPT\n:FORWARD DROP\n:OUTPUT ACCEPT' ]
        run profile_firewall::_inactive "$family" "${native/:FORWARD ACCEPT/:FORWARD UNKNOWN}"
        [ "$status" -ne 0 ]
        run profile_firewall::_inactive "$family" 'unrecognized output' snapshot
        [ "$status" -ne 0 ]
    done
}
