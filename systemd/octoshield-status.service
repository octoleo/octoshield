[Unit]
Description=OctoShield verified protection status and approved exception expiry
After=NetworkManager.service usbguard.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
ExecStart=/usr/local/lib/octoshield/src/status-daemon
Restart=on-failure
RestartSec=5
KillMode=control-group
RuntimeDirectory=octoshield
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
UMask=0077
NoNewPrivileges=yes
ProtectHome=yes
PrivateTmp=yes
# UFW reload applies its configured networking sysctls when an approved timed
# exception expires. A read-only /proc/sys mount would silently prevent expiry.
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6
SystemCallArchitectures=native
RestrictNamespaces=yes
MemoryMax=192M
TasksMax=64
CPUQuota=20%

[Install]
WantedBy=multi-user.target
