[Unit]
Description=OctoShield verified protection status and expiry bookkeeping
After=NetworkManager.service usbguard.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
ExecStart=/usr/local/lib/octoshield/src/status-daemon
Restart=on-failure
RestartSec=5
KillMode=control-group
RuntimeDirectory=octoshield
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
UMask=0077
NoNewPrivileges=yes
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6
SystemCallArchitectures=native
RestrictNamespaces=yes
MemoryMax=192M
TasksMax=64
# A large policy is verified twice when expiry metadata is reconciled. Allow
# up to one CPU so this bounded work completes before the public cache is stale.
CPUQuota=100%

[Install]
WantedBy=multi-user.target
