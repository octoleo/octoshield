[Unit]
Description=OctoShield USB approval prompts for the active desktop
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=/bin/bash /usr/local/lib/octoshield/src/usb-prompt.sh
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=yes
# All writable state uses the user's private runtime directory. Avoid mount
# namespaces here so prompts also work when unprivileged namespaces are disabled.

# GNOME autostart and the application start this companion. It does not enable
# optional security-event notifications or change USB authorization itself.
