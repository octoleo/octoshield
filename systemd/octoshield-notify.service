[Unit]
Description=Octoshield desktop security notifications
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=/bin/bash /usr/local/lib/octoshield/src/notify.sh
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
UMask=0077

[Install]
WantedBy=graphical-session.target
