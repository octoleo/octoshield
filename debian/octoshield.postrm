#!/bin/sh
set -e

# Purge removes only package-owned service enablement. Security configuration,
# USB device rules, and private recovery snapshots deliberately remain intact.
if [ -z "${DPKG_ROOT:-}" ] && command -v systemctl >/dev/null 2>&1; then
    case "$1" in
        purge)
            systemctl disable octoshield-status.service >/dev/null 2>&1 || true
            systemctl disable octoshield-monitor.service >/dev/null 2>&1 || true
            systemctl --global disable octoshield-notify.service >/dev/null 2>&1 || true
            ;;
    esac
    case "$1" in
        remove | purge)
            systemctl daemon-reload >/dev/null 2>&1 || true
            ;;
    esac
fi

if [ -z "${DPKG_ROOT:-}" ]; then
    case "$1" in
        remove | purge | failed-upgrade | abort-install | abort-upgrade)
            rm -f -- /run/octoshield-package-maintenance
            ;;
    esac
fi

#DEBHELPER#

exit 0
