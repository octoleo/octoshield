#!/usr/bin/make -f

export DEB_BUILD_MAINT_OPTIONS = hardening=+all
include /usr/share/dpkg/default.mk

%:
	dh $@

override_dh_auto_build:
	dh_auto_build -- all gui

override_dh_auto_test:
ifeq (,$(filter nocheck,$(DEB_BUILD_OPTIONS)))
	dh_auto_test -- test ui-test
	bash tests/package.sh
endif

override_dh_auto_install:
	dh_auto_install --destdir=$(CURDIR)/debian/octoshield -- install

# Enablement and removal are handled explicitly: even --no-enable generates
# unmask/re-enable snippets on upgrades, which could change the operator's choice.
# Existing monitoring remains running until the operator explicitly restarts it.
override_dh_installsystemd:
	dh_installsystemd --no-scripts octoshield-monitor.service

# Desktop notifications remain an opt-in user choice; removal stops our sessions.
override_dh_installsystemduser:
	dh_installsystemduser --no-scripts octoshield-notify.service
