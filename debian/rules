#!/usr/bin/make -f

export DEB_BUILD_MAINT_OPTIONS = hardening=+all
include /usr/share/dpkg/default.mk

%:
	dh $@

override_dh_auto_build:
	dh_auto_build -- all gui

override_dh_auto_test:
ifeq (,$(filter nocheck,$(DEB_BUILD_OPTIONS)))
	dh_auto_test -- test ui-test
	bash tests/package.sh
endif

override_dh_auto_install:
	dh_auto_install --destdir=$(CURDIR)/debian/octoshield -- install

# Make's install target already stages both vendor units. Do not invoke either
# systemd helper: --no-enable still emits unmask/re-enable scripts, and these
# helpers do not support suppressing autoscripts with the generic --no-scripts
# option. Our explicit maintainer scripts preserve the operator's choices.
override_dh_installsystemd:
	@:

# Desktop notifications remain an opt-in user choice; removal stops our sessions.
override_dh_installsystemduser:
	@:
